# ============================================
# 项目中心服务 - 环境变量配置模板
# 复制本文件为 .env 并修改对应值
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# 服务端口
PORT=3000

# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=myself_blog2

# ============================================
# 内置管理员账号（首次启动自动创建）
# ============================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456

# ============================================
# 会话配置
# ============================================
# 二维码有效期（毫秒）
QR_EXPIRE_MS=120000
# Web 登录态有效期（毫秒，默认 7 天）
WEB_TOKEN_EXPIRE_MS=604800000

# ============================================
# ChatRecord OCR 服务
# ============================================
OCR_PORT=8765
